{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenshot Markup",
  "version": "1.0.0",
  "identifier": "com.abdallah.screenshotmarkup",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Screenshot Markup",
        "width": 1400,
        "height": 900,
        "minWidth": 820,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
